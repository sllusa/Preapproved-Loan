# Database Configuration
# Default: SQLite (no setup required) - recommended for local development
DATABASE_URL=sqlite:///./preapproved_loan.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/preapproved_loan_db

# Application Configuration
SECRET_KEY=change-this-to-a-secure-random-key-in-production
DEBUG=true
API_PORT=9000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# External Service URLs (Mock endpoints for development)
PRE_APPROVAL_ENGINE_URL=http://localhost:8001
IRIS_API_URL=http://localhost:8002
ACCOUNT_VALIDATION_URL=http://localhost:8003
DOCUMENT_GENERATION_URL=http://localhost:8004
CREDITWORTHINESS_SERVICE_URL=http://localhost:8005
FRAUD_SERVICE_URL=http://localhost:8006
AML_SERVICE_URL=http://localhost:8007
SCA_SIGNATURE_URL=http://localhost:8008
AMORTIZATION_SERVICE_URL=http://localhost:8009
SERVICING_CONTEXT_URL=http://localhost:8010

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
