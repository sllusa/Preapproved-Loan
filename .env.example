# Ruralvía Pre-Approved Loan Platform - Environment Configuration
# Copy this file to backend/.env and frontend/.env to configure the application

# ============================================================================
# BACKEND CONFIGURATION (backend/.env)
# ============================================================================

# Database Configuration
# Default: SQLite (no setup required)
# For PostgreSQL: postgresql://user:password@localhost:5432/database_name
DATABASE_URL=sqlite:///./preapproved_loan.db

# Application Configuration
SECRET_KEY=change-this-to-a-secure-random-key-in-production
DEBUG=true
API_PORT=9000

# CORS Origins (comma-separated list of allowed frontend origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# External Service URLs (Mock endpoints for development)
# These services are not included in the starter — the application runs without them
# Replace with actual service URLs in production or when testing integrations
PRE_APPROVAL_ENGINE_URL=http://localhost:8001
IRIS_API_URL=http://localhost:8002
ACCOUNT_VALIDATION_URL=http://localhost:8003
DOCUMENT_GENERATION_URL=http://localhost:8004
CREDITWORTHINESS_SERVICE_URL=http://localhost:8005
FRAUD_SERVICE_URL=http://localhost:8006
AML_SERVICE_URL=http://localhost:8007
SCA_SIGNATURE_URL=http://localhost:8008
AMORTIZATION_SERVICE_URL=http://localhost:8009
SERVICING_CONTEXT_URL=http://localhost:8010

# ============================================================================
# FRONTEND CONFIGURATION (frontend/.env)
# ============================================================================

# API Base URL
# Vite dev server will proxy API requests to this URL
# Default: http://localhost:9000 (matches backend default port)
VITE_API_URL=http://localhost:9000
